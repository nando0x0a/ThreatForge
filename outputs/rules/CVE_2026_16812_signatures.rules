# Confidence: No public PoC known — pattern inferred from the CVE/advisory
# description only. The CISA KEV entry [2] and advisory [5] describe the
# vulnerability as broken access control enabling remote access to privileged
# internal functionality, with OS command injection characteristics per the
# CISA KEV description [2]. No specific URI path, parameter name, or request
# structure has been publicly disclosed for CVE-2026-16812. The content/pcre
# matches below are inferred heuristics based on the VeloCloud Orchestrator
# API surface (typical /portal/rest/ and /vco/ paths used by VCO on-prem)
# and generic OS command injection patterns. These are NOT verified against
# any exploit sample or known attacker tooling.
#
# No packet-capture (PCAP) data source is available to this pipeline —
# this pattern is NOT verified against captured exploit traffic.
#
# ANALYST REVIEW REQUIRED before any deployment. High false-positive and
# false-negative risk. Validate or tune against actual VCO traffic logs.
# This is a proposed draft for analyst review.
alert http $EXTERNAL_NET any -> $HOME_NET any (
  msg:"THREATFORGE CVE-2026-16812 Arista VeloCloud Orchestrator broken access control/cmd injection attempt";
  flow:established,to_server;
  http.uri; content:"/portal/"; nocase;
  pcre:"/\/portal\/(?:rest|jsonrpc|system|internal|admin|operator)\/[^\"]*(?:%7[Cc]%3[Bb]%26|[|;&`]|\$\(|%24%28)/iU";
  reference:cve,2026-16812;
  metadata:mitre_technique_id T1190, is_kev true, status experimental;
  classtype:attempted-admin; sid:9000004; rev:1; )

