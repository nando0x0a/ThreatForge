# ThreatForge Output — SIGNATURES
# CVE:       CVE-2026-56191
# Product:   microsoft exchange
# Tags:      [RCE] [CRIT] [T1]
# Score:     90
# Tier:      CRITICAL — ACT NOW
# Generated: 2026-07-30T02:26:07.848186Z
# Status:    OK
# ---

# Confidence: No public PoC known — pattern inferred from the CVE/advisory
# description only.
# No packet-capture (PCAP) data source is available to this pipeline —
# this pattern is NOT verified against captured exploit traffic.
#
# ANALYST REVIEW REQUIRED BEFORE DEPLOYMENT.
# This rule targets Microsoft Exchange Online (CVE-2026-56191), a broken
# authentication vulnerability (CVSS 10.0 CRITICAL [1]) that allows
# unauthenticated remote attackers to perform data tampering over the
# network with no user interaction required (AV:N/PR:N/UI:N) [1][2].
# The specific HTTP request structure used to trigger the broken
# authentication condition is not publicly documented — no PoC is
# available [2][3]. The content and PCRE matches below target anomalous
# unauthenticated requests to Exchange Online EWS/OWA/MAPI endpoints
# combined with HTTP methods associated with data-tampering operations
# (POST/PUT/PATCH). The match logic is speculative and MUST be validated
# against your environment's Exchange traffic baseline before enabling
# drop/reject actions. False-positive rate is expected to be high without
# further tuning.
#
# SEVERITY DISCREPANCY NOTE: Only a single CVSS score of 10.0 (CRITICAL)
# is available in the supplied context [1]. No secondary source score is
# present to compare. Analyst should verify scoring against [2] and [3]
# if updated advisory detail becomes available.
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (
  msg:"THREATFORGE CVE-2026-56191 Microsoft Exchange Online broken authentication data tampering attempt";
  flow:established,to_server;
  http.method; content:"POST"; nocase;
  http.uri; content:"/EWS/Exchange.asmx"; nocase;
  http.header; pcre:"/^Authorization\s*:/Hmi"; within:200;
  pcre:"/^Authorization\s*:\s*(None|anonymous|$)/Hmi";
  threshold:type both, track by_src, count 3, seconds 10;
  reference:cve,2026-56191;
  metadata:mitre_technique_id T1190, is_kev false, status experimental;
  classtype:attempted-admin; sid:9000104; rev:1; )

